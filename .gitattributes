# Normaliza los finales de línea: el repo siempre guarda LF.
# Evita el "churn" de CRLF en Windows (sobre todo en los .g.dart regenerados por build_runner).
* text=auto eol=lf

# Código y texto -> LF
*.dart   text eol=lf
*.kt     text eol=lf
*.kts    text eol=lf
*.java   text eol=lf
*.gradle text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.xml    text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.sh     text eol=lf

# Windows scripts -> CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binarios: que git no los toque
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.ttf    binary
*.otf    binary
*.woff   binary
*.woff2  binary
*.jar    binary
*.keystore binary
*.jks    binary
*.p12    binary
*.so     binary
*.dll    binary
